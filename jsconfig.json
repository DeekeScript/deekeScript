{
    "compilerOptions": {
        "target": "ES6",
        "lib": [
            "es2016",
        ],
        "checkJs": true,
        "allowJs": true,
        "module": "commonjs",
        "moduleResolution": "node10",
        "types": [
            "node"
        ],
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "app/*": [
                "app/*"
            ]
        },
    },
    "include": [
        "**/*",
        "@deekeScript/**/*"
    ]
}